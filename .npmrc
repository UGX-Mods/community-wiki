# supply chain hardening (needs the npm version from devEngines in package.json)

# only the public registry, no git / tarball url / local file dependencies
registry=https://registry.npmjs.org/
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none

# only resolve versions that have been public for 3 days (same as dependabot cooldown)
min-release-age=3

# pinning: exact versions in package.json, the lockfile pins transitive deps
save-exact=true

# fail on engine mismatches instead of warning
engine-strict=true

# install scripts must be reviewed in package.json "allowScripts" (npm approve-scripts / npm deny-scripts)
strict-allow-scripts=true
