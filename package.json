{
  "name": "ugx-community-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "Official UGX-Mods Wiki for Call of Duty Modding and for UGX Products & Services.",
  "author": "Alexander 'Delta' Diller",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UGX-Mods/community-wiki.git"
  },
  "homepage": "https://wiki.ugx-mods.com",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass --no-source-map wiki.scss wiki.css && esbuild wiki.css --minify --log-level=warning --outfile=wiki.min.css",
    "build:js": "esbuild wiki.js --minify --target=es2019 --log-level=warning --outfile=wiki.min.js",
    "format": "prettier --write . && stylelint \"**/*.scss\" --fix",
    "lint": "npm run lint:format && npm run lint:style",
    "lint:format": "prettier --check .",
    "lint:style": "stylelint \"**/*.scss\" --max-warnings 0",
    "validate": "node main.js validate",
    "tools": "node main.js",
    "check": "npm run lint && npm run validate && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "node-html-parser": "^9.0.5"
  },
  "devDependencies": {
    "@stylistic/stylelint-config": "^5.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.3.0"
  }
}
